{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategoi.dev/schemas/Pipeline.schema.json",
  "title": "Pipeline spec",
  "description": "An ordered list of steps. Each step is a source, a transform or a sink, by its registered name.",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(sources|transforms|sinks)\\.[a-z][a-z0-9_]*$" }
    }
  }
}
